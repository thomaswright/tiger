{
  "name": "tiger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "res:build": "rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript -w",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite --host",
    "build": "tsc -b && WRANGLER_LOG_PATH=.wrangler/wrangler.log vite build",
    "db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply DB --local",
    "db:migrations:list": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations list DB --local",
    "lint": "eslint .",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/helpers": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@legendapp/state": "^3.0.0-beta.30",
    "@radix-ui/colors": "^3.0.0",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@rescript/core": "^1.6.0",
    "@rescript/react": "^0.12.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tanstack/react-query": "^5.101.4",
    "date-fns": "^4.1.0",
    "jose": "^6.2.6",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "react-textarea-autosize": "^8.5.4",
    "rescript": "^11.1.4",
    "rescript-webapi": "^0.10.0",
    "uuid": "^11.0.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/workers-types": "^5.20260801.1",
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^15.11.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
